{
  "name": "margindesk-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf .next/standalone/.next/static && cp -r .next/static .next/standalone/.next/static && if [ -d public ]; then rm -rf .next/standalone/public && cp -r public .next/standalone/public; fi",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "csv-parse": "6.1.0",
    "next": "16.2.6",
    "next-auth": "4.24.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.18",
    "postcss": "8.5.14",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "preact": ">=10.27.3",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "minimatch": ">=3.1.3",
      "postcss": ">=8.5.10"
    }
  }
}
