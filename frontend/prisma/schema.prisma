// ---------------------------------------------------------------------------
// Contract register: what gives DWAO the right to bill (or the duty to pay) a
// counterparty. A Contract is the resolved, current position for one
// counterparty; its lines are the individual billing terms, each traceable to
// the clause it was read from. Rows are first loaded from documents and then
// confirmed or corrected by the team.
// ---------------------------------------------------------------------------
model Contract {
  id              String                  @id @default(cuid())
  counterparty    String
  client_id       String?
  direction       ContractDirection       @default(customer)
  basis           String // e.g. "Signed agreement + PO", "PO only", "Expired agreement, work continuing"
  bill_to         String?
  start_date      DateTime?
  end_date        DateTime?
  spoc            String? // person responsible for follow-up, as a name (kept in step with spoc_person)
  spoc_person_id  String? // the employee who follows this contract up
  agreement_id    String? // the MSA / framework this SOW is governed by
  stage           String                  @default("active") // active | renewal_in_progress | awaiting_signature | awaiting_po | closed
  po_status       String?
  notes           String?
  open_questions  Json                    @default("[]") // [{ text, resolved }]
  documents       Json? // documents read when the entry was loaded
  source_key      String?                 @unique // stable key for re-loading from documents
  zoho_customer_id String? // Zoho Books customer the contract is invoiced to
  loaded_at       DateTime?
  verified        Boolean                 @default(false) // a person has checked the entry against the signed copy
  verified_by     String?
  verified_at     DateTime?
  // Validation by the three teams. The contract is "verified" once all three are done.
  paper_checked_by      String? // contracting / legal: documents attached, basis, dates and invoiced-to confirmed
  paper_checked_at      DateTime?
  commercial_checked_by String? // the lead: every billing rule confirmed
  commercial_checked_at DateTime?
  billing_checked_by    String? // finance: company in Zoho, tax, currency, terms, PO
  billing_checked_at    DateTime?
  review_bucket   String? // clean | open | document_awaited, set when the contract reads were loaded
  review_pointers Json                    @default("[]") // [{ kind, text, big, resolved }] - what a person must settle before billing
  read_file       String? // contracts_v2 file the entry was loaded from
  read_at         DateTime?
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt
  client          Client?                 @relation(fields: [client_id], references: [id])
  spoc_person     Person?                 @relation("ContractSpoc", fields: [spoc_person_id], references: [id])
  agreement       Agreement?              @relation(fields: [agreement_id], references: [id], onDelete: SetNull)
  lines           ContractLine[]
  purchase_orders ContractPurchaseOrder[]
  tasks           ContractTask[]
  billing_rules   BillingRule[]
  draft_estimates DraftEstimate[]

  @@index([end_date])
  @@index([client_id])
  @@index([spoc])
  @@index([spoc_person_id])
  @@index([agreement_id])
  @@index([review_bucket])
}

model ContractLine {
  id              String    @id @default(cuid())
  contract_id     String
  project_id      String?
  service         String
  billing_type    String // Hourly rate | Hours bundle | Per person / FTE | Fixed monthly fee | Milestone | ...
  amount_text     String // as written in the document
  amount          Decimal?  @db.Decimal(15, 2) // set when the amount is a single clean figure
  unit            String?
  currency        String    @default("INR")
  start_date      DateTime?
  end_date        DateTime?
  date_note       String?
  read_from       String    @default("Contract") // Contract | Purchase order | Unsigned draft
  source_document String?
  quote           String?
  extra_rule      String?
  verified        Boolean   @default(false)
  sort_order      Int       @default(0)
  // How the term is billed, in a form the draft estimates can compute from.
  shape           String? // key into SHAPES; null until invoicing sets it
  params          Json      @default("{}")
  period          String? // weekly | monthly | quarterly | yearly | one-time
  fx_rate         Decimal?  @db.Decimal(12, 4)
  input_needed    String? // the number someone must supply each period
  advance_or_arrears String?
  rule_status     String    @default("proposed") // proposed | confirmed | retired
  confirmed_by    String?
  confirmed_at    DateTime?
  rule_evidence   Json? // what past invoices show for this term
  billing_rule_id String? // the rule this shape was folded in from
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  contract        Contract  @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  project         Project?  @relation(fields: [project_id], references: [id])
  draft_lines     DraftEstimateLine[]

  @@index([contract_id])
  @@index([end_date])
  @@index([project_id])
  @@index([rule_status])
}

// A billing rule is the computable form of a billing term: one shape (see
// src/lib/billing/shapes.ts) plus its parameters. Rules are proposed from
// invoices or contracts and only used for billing once a person confirms them.
model BillingRule {
  id           String            @id @default(cuid())
  contract_id  String
  project_id   String?
  service      String // invoice item, e.g. "Adobe Analytics Consulting"
  label        String? // what tells this rule apart within the service: a project, person or role
  family       String?
  shape        String // key into SHAPES; "unknown" until someone sets it
  params       Json              @default("{}")
  period       String            @default("monthly") // weekly | monthly | quarterly | yearly | one-time
  currency     String            @default("INR")
  fx_rate      Decimal?          @db.Decimal(12, 4) // exchange rate fixed by the contract, if any
  start_date   DateTime?
  end_date     DateTime?
  source       String            @default("manual") // invoices | contract | manual
  status       BillingRuleStatus @default(proposed)
  confidence   String? // high | medium | low, for proposed rules
  evidence     Json? // months billed, last invoice, last amount and wording
  notes        String?
  auto_key     String?           @unique // set on derived rules so a re-load updates rather than duplicates
  confirmed_by String?
  confirmed_at DateTime?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  contract     Contract          @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [project_id], references: [id])
  draft_lines  DraftEstimateLine[]

  @@index([contract_id])
  @@index([status])
  @@index([project_id])
}

model ContractPurchaseOrder {
  id          String    @id @default(cuid())
  contract_id String
  po_number   String
  po_date     DateTime?
  valid_from  DateTime?
  valid_to    DateTime?
  value_text  String?
  hours_text  String?
  rate_text   String?
  covers      String?
  document    String?
  value       Decimal?  @db.Decimal(15, 2) // numeric value before tax, when the document gives one
  currency    String?
  status      String? // valid | expired | no validity stated, as of the last read
  auto_key    String?   @unique // set on loaded POs so a re-load updates rather than duplicates
  // Consumption, recomputed nightly from Zoho invoices that quote the PO.
  opening_consumed     Decimal?  @db.Decimal(15, 2) // invoiced before our invoice data starts
  consumed             Decimal?  @db.Decimal(15, 2)
  consumed_as_of       DateTime?
  run_rate             Decimal?  @db.Decimal(15, 2) // per month, last three months
  projected_exhaustion DateTime?
  alert_state          String? // healthy | low | exhausting_before_term | over_consumed | expiring_with_balance | expired | no_value
  notes                String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  contract    Contract  @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  invoices    ZohoInvoice[]
  credit_notes ZohoCreditNote[]
  draft_estimates DraftEstimate[]

  @@index([contract_id])
  @@index([valid_to])
  @@index([alert_state])
}

model ContractTask {
  id           String             @id @default(cuid())
  contract_id  String?
  kind         String // renewal | purchase_order | invoice_deadline | follow_up | review
  title        String
  detail       String?
  due_date     DateTime
  owner        String?
  status       ContractTaskStatus @default(open)
  auto_key     String?            @unique // set on system-generated tasks so they are never duplicated
  created_by   String?
  completed_by String?
  completed_at DateTime?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  contract     Contract?          @relation(fields: [contract_id], references: [id], onDelete: Cascade)

  @@index([due_date])
  @@index([status, due_date])
  @@index([owner])
  @@index([contract_id])
}

enum ContractDirection {
  customer // DWAO bills the counterparty
  vendor // DWAO pays the counterparty
  both
  nda // confidentiality only, nothing to bill
}

enum BillingRuleStatus {
  proposed // derived, not yet checked by a person
  confirmed // checked, can be used for billing
  retired // no longer applies
}

enum ContractTaskStatus {
  open
  done
  dismissed
}

// Zoho Books invoices, read-only copy refreshed nightly. Used for purchase
// order consumption and, later, for comparing draft estimates with what was
// raised. Amounts are in the invoice currency; exchange_rate converts to INR.
model ZohoInvoice {
  id                 String    @id @default(cuid())
  zoho_invoice_id    String    @unique
  invoice_number     String
  zoho_customer_id   String
  customer_name      String
  client_id          String?
  date               DateTime
  due_date           DateTime?
  status             String
  currency           String    @default("INR")
  exchange_rate      Decimal   @default(1) @db.Decimal(12, 6)
  sub_total          Decimal   @db.Decimal(15, 2)
  tax_total          Decimal   @default(0) @db.Decimal(15, 2)
  total              Decimal   @db.Decimal(15, 2)
  balance            Decimal   @default(0) @db.Decimal(15, 2)
  reference_number   String?
  service_month      DateTime?
  team               String?
  zoho_estimate_id   String?
  purchase_order_id  String?
  po_match           String? // reference | manual
  last_modified_time DateTime?
  synced_at          DateTime  @default(now())
  lines              ZohoInvoiceLine[]
  purchase_order     ContractPurchaseOrder? @relation(fields: [purchase_order_id], references: [id], onDelete: SetNull)

  @@index([zoho_customer_id])
  @@index([client_id])
  @@index([date])
  @@index([purchase_order_id])
  @@index([reference_number])
}

model ZohoInvoiceLine {
